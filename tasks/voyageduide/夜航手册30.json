{
  "task": [
    {
      "name": "夜航手册30",
      "entry": "夜航30-启动",
      "description": "resource/descs/nightguide/30.md",
      "option": [
        "夜航30副本选择",
        "夜航30加成书选择",
        "夜航30主控",
        "夜航30刷取次数",
        "夜航30超时时间"
      ]
    }
  ],
  "option": {
    "夜航30副本选择": {
      "label": "副本选择",
      "type": "select",
      "default_case": "第一个",
      "description": "选择第几个副本进行刷取",
      "cases": [
        {
          "name": "第一个",
          "option": [
            "夜航30轮次选择"
          ],
          "pipeline_override": {
            "夜航30-选择副本": {
              "custom_action_param": "夜航-30-1"
            }
          }
        },
        {
          "name": "第二个",
          "option": [
            "夜航30轮次选择"
          ],
          "pipeline_override": {
            "夜航30-选择副本": {
              "custom_action_param": "夜航-30-2"
            }
          }
        },
        {
          "name": "第三个",
          "option": [
            "夜航30轮次选择"
          ],
          "pipeline_override": {
            "夜航30-选择副本": {
              "custom_action_param": "夜航-30-3"
            }
          }
        },
        {
          "name": "第四个",
          "option": [
            "夜航30轮次选择"
          ],
          "pipeline_override": {
            "夜航30-选择副本": {
              "custom_action_param": "夜航-30-4"
            }
          }
        }
      ]
    },
    "夜航30加成书选择": {
      "label": "加成书选择",
      "type": "select",
      "description": "选择加成书",
      "default_case": "不加成",
      "cases": [
        {
          "name": "不加成",
          "icon": "./resource/image/加成书/不加成.png",
          "pipeline_override": {
            "夜航-加成书选择": {
              "custom_action_param": "不选书"
            },
            "再次进行选书": {
              "custom_action_param": "不选书"
            }
          }
        },
        {
          "name": "绿书（1倍）",
          "icon": "./resource/image/加成书/绿书.png",
          "pipeline_override": {
            "夜航-加成书选择": {
              "custom_action_param": "绿书"
            },
            "再次进行选书": {
              "custom_action_param": "绿书"
            }
          }
        },
        {
          "name": "蓝书（2倍）",
          "icon": "./resource/image/加成书/蓝书.png",
          "pipeline_override": {
            "夜航-加成书选择": {
              "custom_action_param": "蓝书"
            },
            "再次进行选书": {
              "custom_action_param": "蓝书"
            }
          }
        },
        {
          "name": "紫书（8倍）",
          "icon": "./resource/image/加成书/紫书.png",
          "pipeline_override": {
            "夜航-加成书选择": {
              "custom_action_param": "紫书"
            },
            "再次进行选书": {
              "custom_action_param": "紫书"
            }
          }
        },
        {
          "name": "金书（20倍）",
          "icon": "./resource/image/加成书/金书.png",
          "pipeline_override": {
            "夜航-加成书选择": {
              "custom_action_param": "金书"
            },
            "再次进行选书": {
              "custom_action_param": "金书"
            }
          }
        }
      ]
    },
    "夜航30超时时间": {
      "type": "input",
      "inputs": [
        {
          "name": "超时时间",
          "description": "单位为秒，请合理配置",
          "default": "180",
          "pipeline_type": "int",
          "verify": "^\\d+$"
        }
      ],
      "pipeline_override": {
        "夜航30-超时计时开始": {
          "custom_action_param": {
            "duration": "{超时时间}"
          }
        },
        "夜航30-重新计时": {
          "custom_action_param": {
            "duration": "{超时时间}"
          }
        }
      }
    },
    "夜航30刷取次数": {
      "type": "input",
      "inputs": [
        {
          "name": "刷取次数",
          "description": "配置为0即为无限刷取（或者你可以配置一个很大的数）",
          "default": "0",
          "pipeline_type": "int",
          "verify": "^\\d+$"
        }
      ],
      "pipeline_override": {
        "夜航30-总计数": {
          "custom_action_param": {
            "id": "all",
            "target": "{刷取次数}"
          }
        }
      }
    },
    "夜航30主控": {
      "label": "主控",
      "type": "select",
      "default_case": "黎瑟",
      "cases": [
        {
          "name": "黎瑟",
          "option": [
            "夜航30黎瑟技能释放间隔"
          ],
          "pipeline_override": {
            "夜航30-角色主控": {
              "custom_action_param": "黎瑟"
            }
          }
        },
        {
          "name": "水母",
          "option": [
            "夜航30水母技能释放间隔"
          ],
          "pipeline_override": {
            "夜航30-角色主控": {
              "custom_action_param": "水母"
            }
          }
        }
      ]
    },
    "夜航30黎瑟技能释放间隔": {
      "label": "黎瑟技能释放间隔（Q技能）",
      "type": "input",
      "inputs": [
        {
          "name": "黎瑟技能释放间隔",
          "description": "单位为秒，请合理配置",
          "default": "20",
          "pipeline_type": "int",
          "verify": "^(?:[1-9]|1[0-9]|20)$"
        }
      ],
      "pipeline_override": {
        "夜航30-检测是否完成委托": {
          "custom_action_param": {
            "count": "{黎瑟技能释放间隔}",
            "nodes": [
              "委托完成"
            ]
          }
        }
      }
    },
    "夜航30水母技能释放间隔": {
      "label": "水母技能释放间隔（E技能）",
      "type": "input",
      "inputs": [
        {
          "name": "水母技能释放间隔",
          "description": "单位为秒，请合理配置",
          "default": "6",
          "pipeline_type": "int",
          "verify": "^(?:[1-9]|1[0-9]|20)$"
        }
      ],
      "pipeline_override": {
        "夜航30-检测是否完成委托": {
          "custom_action_param": {
            "count": "{水母技能释放间隔}",
            "nodes": [
              "委托完成"
            ]
          }
        }
      }
    },
    "夜航30轮次选择": {
      "label": "轮次选择",
      "type": "input",
      "description": "设置自动轮次功能的目标轮数",
      "inputs": [
        {
          "name": "轮次",
          "description": "输入目标轮次",
          "default": "1",
          "pipeline_type": "int",
          "verify": "^(?:[1-9]|[1-9]\\d)$"
        }
      ],
      "pipeline_override": {
        "夜航30-检测轮次": {
          "custom_action_param": {
            "target": "{轮次}"
          }
        }
      }
    }
  }
}