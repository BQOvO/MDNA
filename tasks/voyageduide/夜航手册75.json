    "夜航75超时时间": {
      "type": "input",
      "inputs": [
        {
          "name": "超时时间",
          "description": "单位为秒，请合理配置",
          "default": "180",
          "pipeline_type": "int",
          "verify": "^\\d+$"
        }
      ],
      "pipeline_override": {
        "夜航75-超时计时开始": {
          "custom_action_param": {
            "duration": "{超时时间}"
          }
        },
        "夜航75-重新计时": {
          "custom_action_param": {
            "duration": "{超时时间}"
          }
        }
      }
    },
    "夜航75刷取次数": {
      "type": "input",
      "inputs": [
        {
          "name": "刷取次数",
          "description": "配置为0即为无限刷取（或者你可以配置一个很大的数）",
          "default": "0",
          "pipeline_type": "int",
          "verify": "^\\d+$"
        }
      ],
      "pipeline_override": {
        "夜航75-总计数": {
          "custom_action_param": {
            "id": "all",
            "target": "{刷取次数}"
          }
        }
      }
    },
    "夜航75主控": {
      "label": "主控",
      "type": "select",
      "default_case": "黎瑟",
