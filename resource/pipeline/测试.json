        ]
    },
    "RoundTracker测试-输出失败": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "CountPrint",
                "custom_action_param": "=== RoundTracker 测试：on_error 分支触发（基线记录 / 数字未变化 / 重试耗尽）==="
            }
        },
        "focus": {
            "Node.Recognition.Succeeded": "RoundTracker 失败 (on_error)"
        },
        "post_delay": 2000,
        "next": [
            "RoundTracker测试-执行"
        ]
